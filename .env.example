# Copy to .env ON THE SERVER and fill in. Never commit .env.
# Private key (64 hex chars, no 0x) of a NEW wallet used only for this faucet. Fund it with Base Sepolia ETH.
FAUCET_ETH_WALLET_KEY=
# Long random string, e.g. output of: openssl rand -hex 40
FAUCET_SECRET=
# Only if captcha is enabled in data/faucet-config.yaml:
FAUCET_CAPTCHA_SECRET=
